#!/usr/bin/env python3
"""Glint: small, cute, and it wears your rice. Colours follow Caelestia (or pywal, or your GTK theme) live."""
import json, os, pathlib, shutil, subprocess, sys, threading
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk
try:                                    # optional: a real layer-shell popup (no window-manager tricks needed)
    gi.require_version("Gtk4LayerShell", "1"); from gi.repository import Gtk4LayerShell as LS
except Exception:
    LS = None

H = pathlib.Path.home()
CFG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", H / ".config")) / "glint"
SCHEME = H / ".local/state/caelestia/scheme.json"
WAL = H / ".cache/wal/colors.json"
_here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "glint")
CLI = _here if os.path.exists(_here) else (shutil.which("glint") or "glint")
LABELS = {"brightness": "Brightness", "contrast": "Contrast", "red": "Red", "green": "Green", "blue": "Blue"}
COLOURS = ["srgb", "native", "4000k", "5000k", "6500k", "7500k", "8200k", "9300k", "11500k", "user"]
SOURCES = ["auto", "caelestia", "pywal", "gtk", "system"]
POPUP_FILE = CFG / "popup.json"
POSITIONS = ["top-right", "top-left", "bottom-right", "bottom-left", "top", "bottom"]
POPUP_PARTS = [("contrast", "Contrast"), ("colour", "Colour temperature"), ("rgb", "Red / green / blue"), ("looks", "One-tap looks")]


def popup_cfg():
    d = {"position": "top-right", "show": ["contrast", "colour", "rgb", "looks"], "pill": False}
    try: d.update(json.load(open(POPUP_FILE)))
    except Exception: pass
    return d

def save_popup(d):
    CFG.mkdir(parents=True, exist_ok=True); json.dump(d, open(POPUP_FILE, "w"), indent=2)


# ---------------------------------------------------------------- shortcut capture: press the keys, Glint writes them down
MOD_KEYS = {"Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R", "Meta_L", "Meta_R", "Super_L", "Super_R",
            "Hyper_L", "Hyper_R", "ISO_Level3_Shift", "Caps_Lock", "Num_Lock"}

def mods_of(state):
    """Hyprland-style modifier words from a GTK modifier mask, in a fixed order."""
    out = []
    for flag, word in ((Gdk.ModifierType.SUPER_MASK, "SUPER"), (Gdk.ModifierType.CONTROL_MASK, "CTRL"),
                       (Gdk.ModifierType.ALT_MASK, "ALT"), (Gdk.ModifierType.SHIFT_MASK, "SHIFT")):
        if state & flag: out.append(word)
    return out

def key_name(keyval, keycode):
    """The key as Hyprland spells it (m, Up, F9, space...), ignoring Shift so SHIFT+1 stays '1'."""
    try:
        ok, kv, *_ = Gdk.Display.get_default().translate_key(keycode, Gdk.ModifierType(0), 0)
        if ok and kv: keyval = kv
    except Exception: pass
    return Gdk.keyval_name(Gdk.keyval_to_lower(keyval)) or ""

def combo_text(mods, key=""):
    return " ".join(mods) + (f", {key}" if key else "")


def cli(*args):
    """Run the glint CLI. Never raises: a missing binary or a hung monitor becomes an error result, so the UI can't hang on 'loading...'."""
    try:
        r = subprocess.run([CLI, *args], capture_output=True, text=True, timeout=30)
        return r.returncode, r.stdout, r.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"Can't find the glint command ({CLI}). Reinstall Glint or add ~/.local/bin to your PATH."
    except subprocess.TimeoutExpired:
        return 124, "", "The monitor took too long to answer (ddcutil). Try again."
    except Exception as e:
        return 1, "", str(e)


# ---------------------------------------------------------------- theme: wears your rice, live
def hexc(c): return "#%02x%02x%02x" % tuple(max(0, min(255, round(x))) for x in c)

def rgba(h, a):
    h = h.lstrip("#"); r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4)); return f"rgba({r},{g},{b},{a})"

def theme_cfg():
    try: return json.load(open(CFG / "theme.json"))
    except Exception: return {}

def watched():
    out = []
    for f in (SCHEME, WAL, CFG / "theme.json", CFG / "theme.css"):
        try: out.append(f.stat().st_mtime_ns)
        except OSError: out.append(0)
    return tuple(out)

def build_css(t):
    p, r, glass = t.get("palette"), int(t.get("radius", 18)), float(t.get("glass", 1.0))
    css = ""
    if p:
        win = rgba(p["bg"], glass) if glass < 1 else p["bg"]
        m = {"window_bg": win, "window_fg": p["fg"], "view_bg": p["view"], "view_fg": p["fg"], "headerbar_bg": p["header"],
             "headerbar_fg": p["fg"], "card_bg": rgba(p["card"], max(glass, .55)) if glass < 1 else p["card"], "card_fg": p["fg"],
             "popover_bg": p["card"], "popover_fg": p["fg"], "dialog_bg": p["card"], "dialog_fg": p["fg"], "accent_bg": p["accent"],
             "accent_fg": p["accentfg"], "accent": p["accent"], "sidebar_bg": p["header"], "sidebar_fg": p["fg"]}
        css += "".join(f"@define-color {k}_color {v};\n" for k, v in m.items())
        css += f"@define-color destructive_bg_color {p['error']};\n@define-color glint_two {p['secondary']};\n@define-color glint_three {p['tertiary']};\n"
    else:
        css += "@define-color glint_two @accent_bg_color;\n@define-color glint_three @accent_bg_color;\n"
    css += f"""
window {{ background: @window_bg_color; }}
.glint-hero {{ border-radius: {r + 6}px; padding: 18px 20px; color: @accent_fg_color;
  background-image: linear-gradient(120deg, @accent_bg_color 0%, @glint_two 55%, @glint_three 100%); }}
.glint-hero label.title {{ font-size: 26px; font-weight: 800; letter-spacing: -0.5px; }}
.glint-hero label.sub {{ opacity: .85; }}
.glint-chip {{ border-radius: 999px; padding: 2px 10px; background: alpha(@accent_fg_color, .18); font-weight: 600; }}
.glint-dot {{ min-width: 18px; min-height: 18px; border-radius: 999px; }}
preferencesgroup > box > box > list, list.boxed-list {{ border-radius: {r}px; }}
row:first-child {{ border-top-left-radius: {r}px; border-top-right-radius: {r}px; }}
row:last-child {{ border-bottom-left-radius: {r}px; border-bottom-right-radius: {r}px; }}
button {{ border-radius: {max(r - 4, 6)}px; }} button.pill {{ border-radius: 999px; padding: 8px 20px; font-weight: 600; }}
button.pill.suggested-action {{ box-shadow: 0 2px 14px -4px @accent_bg_color; }}
entry, row.entry {{ border-radius: {max(r - 4, 6)}px; }}
scale trough {{ min-height: 8px; border-radius: 999px; }} scale highlight {{ border-radius: 999px; background: @accent_bg_color; }}
scale slider {{ min-width: 20px; min-height: 20px; border-radius: 999px; background: @accent_bg_color; box-shadow: 0 0 0 3px alpha(@accent_bg_color, .25); }}
scale.red highlight, scale.red slider {{ background: #ff6b81; }} scale.green highlight, scale.green slider {{ background: #5fd38d; }}
scale.blue highlight, scale.blue slider {{ background: #6ea8ff; }}
window.glint-popwin {{ background: transparent; }}
.glint-pop {{ background: @window_bg_color; color: @window_fg_color; border-radius: {r + 6}px; border: 1px solid alpha(@window_fg_color, .14);
  box-shadow: 0 10px 34px -10px rgba(0,0,0,.55); padding: 14px; }}
.glint-pop label.pop-title {{ font-weight: 800; font-size: 16px; }}
.glint-rec {{ background: alpha(@accent_bg_color, .2); box-shadow: inset 0 0 0 2px @accent_bg_color; }}
headerbar {{ box-shadow: none; }} dialog, window.dialog {{ border-radius: {r + 4}px; }}
"""
    if p:
        css += "".join(f".dot-{k} {{ background: {p[k]}; border: 1px solid alpha(@window_fg_color, .25); }}\n" for k in ("bg", "card", "accent", "secondary", "tertiary", "fg"))
    try: css += (CFG / "theme.css").read_text()   # your own touches always win
    except Exception: pass
    return css


class Theme:
    def __init__(self):
        self.prov = Gtk.CssProvider(); self.t = {}; self.last = None; self.listeners = []
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.refresh(force=True)
        GLib.timeout_add_seconds(2, self.poll)   # cheap and reliable: notices scheme changes however they are written

    def poll(self):
        w = watched()
        if w != self.last: self.refresh()
        return True

    def refresh(self, force=False):
        self.last = watched()
        def work():
            rc, out, _ = cli("theme", "--json")
            if rc == 0 and out.strip(): GLib.idle_add(self.apply, json.loads(out))
        threading.Thread(target=work, daemon=True).start()

    def apply(self, t):
        self.t = t; p = t.get("palette")
        sm = Adw.StyleManager.get_default()
        sm.set_color_scheme(Adw.ColorScheme.DEFAULT if not p else (Adw.ColorScheme.FORCE_LIGHT if t.get("mode") == "light" else Adw.ColorScheme.FORCE_DARK))
        css = build_css(t)
        try: self.prov.load_from_string(css)
        except AttributeError: self.prov.load_from_data(css.encode())
        for f in self.listeners: f(t)


# ---------------------------------------------------------------- window
class Win(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Glint", default_width=600, default_height=780)
        self.connect("close-request", lambda *_: (setattr(app, "main", None), False)[1])
        self.timers = {}; self.theme = app.theme; self.sync_on = False; self.rec = None
        view = Adw.ToolbarView(); bar = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Reload"); refresh.connect("clicked", lambda *_: self.load())
        bar.pack_start(refresh)
        self.stack = Adw.ViewStack(vexpand=True); self.pages = {}
        for key, title, icon in (("screen", "Screen", "video-display-symbolic"), ("colour", "Colour", "weather-clear-symbolic"),
                                 ("keys", "Keys", "input-keyboard-symbolic"), ("look", "Look", "applications-graphics-symbolic")):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin_top=16, margin_bottom=16, margin_start=16, margin_end=16)
            sc = Gtk.ScrolledWindow(vexpand=True); sc.set_child(Adw.Clamp(child=box, maximum_size=640))
            self.stack.add_titled_with_icon(sc, key, title, icon); self.pages[key] = box
        bar.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        view.add_top_bar(bar)
        self.status = Gtk.Label(label="", margin_bottom=8, margin_top=4); self.status.add_css_class("dim-label")
        hero = Gtk.Box(spacing=14, margin_top=12, margin_start=16, margin_end=16); hero.add_css_class("glint-hero")
        img = Gtk.Image.new_from_icon_name("video-display-symbolic"); img.set_pixel_size(44); hero.append(img)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        t1 = Gtk.Label(label="Glint", xalign=0); t1.add_css_class("title")
        t2 = Gtk.Label(label="your monitor, wearing your rice", xalign=0); t2.add_css_class("sub")
        tb.append(t1); tb.append(t2); hero.append(tb)
        self.chip = Gtk.Label(valign=Gtk.Align.CENTER); self.chip.add_css_class("glint-chip"); hero.append(self.chip)
        self.theme.listeners.append(self.on_theme); self.on_theme(self.theme.t)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); col.append(hero); col.append(self.stack); col.append(self.status)
        view.set_content(col); self.set_content(view)
        self.load()

    def on_theme(self, t):
        if not t: self.chip.set_text("loading..."); return
        self.chip.set_text("your system theme" if t["source"] == "system" else f"{t['source']} · {t['mode']}")

    def say(self, text): GLib.idle_add(self.status.set_text, text)

    def load(self):
        self.say("Reading your monitor...")
        def work():
            try:
                rc, out, err = cli("get", "--json")
                _, prof, _ = cli("profile", "list", "--json")
                _, auto, _ = cli("auto", "status")
                src, sout, _ = cli("screen", "list", "--json")
                krc, kout, _ = cli("keys", "list", "--json")
                _, so, _ = cli("sync", "status"); self.sync_on = so.strip() == "on"
                screens = json.loads(sout)["outputs"] if src == 0 and sout.strip() else []
                keys = json.loads(kout) if krc == 0 and kout.strip() else None
                disp = json.loads(out)["displays"] if rc == 0 else []
                profiles = json.loads(prof or "[]") if rc == 0 else []
                note = "" if rc == 0 else (err or "Brightness and colour need DDC/CI. Run `glint doctor`.")
            except Exception as e:   # whatever goes wrong, show the window instead of staying on 'loading...'
                disp, profiles, auto, screens, keys, note = [], [], "", [], None, f"Could not read your monitor: {e}"
            GLib.idle_add(self.build, disp, profiles, auto.strip() == "on", screens, keys, note)
        threading.Thread(target=work, daemon=True).start()

    def clear(self):
        for box in self.pages.values():
            while (c := box.get_first_child()): box.remove(c)

    def note(self, page, text):
        l = Gtk.Label(label=text, wrap=True); l.add_css_class("dim-label"); self.pages[page].append(l)

    # ---- screen
    def build_screen(self, o):
        grp = Adw.PreferencesGroup(title=o["label"], description=f"Output {o['name']}. Kept settings survive reboots.")
        res_list = sorted(o["modes"], key=lambda r: tuple(int(x) for x in r.split("x")), reverse=True)
        cur_res = f"{o['width']}x{o['height']}"
        res = Adw.ComboRow(title="Resolution", model=Gtk.StringList.new(res_list))
        res.set_selected(res_list.index(cur_res) if cur_res in res_list else 0)
        hz = Adw.ComboRow(title="Refresh rate (Hz)")
        def fill_hz(*_):
            rates = sorted(o["modes"][res_list[res.get_selected()]], key=float, reverse=True)
            hz.set_model(Gtk.StringList.new(rates))
            hz.set_selected(min(range(len(rates)), key=lambda i: abs(float(rates[i]) - o["refresh"])))
        res.connect("notify::selected", fill_hz); fill_hz()
        scale = Adw.SpinRow.new_with_range(0.5, 3.0, 0.05); scale.set_title("Scale"); scale.set_digits(2); scale.set_value(float(o["scale"]))
        scale.set_visible(o.get("can_scale", True))
        rot = Adw.ComboRow(title="Rotation", model=Gtk.StringList.new(["Normal", "Rotate 90", "Rotate 180", "Rotate 270"]))
        rot.set_selected(min(int(o["transform"]), 3))
        pos = Adw.EntryRow(title="Position (x by y, e.g. 0x0 or 2560x0)"); pos.set_text(f"{o['x']}x{o['y']}")
        btn = Gtk.Button(label="Apply", halign=Gtk.Align.END, margin_top=8); btn.add_css_class("suggested-action"); btn.add_css_class("pill")
        def now():
            return ["--resolution", res_list[res.get_selected()], "--refresh", hz.get_model().get_string(hz.get_selected()),
                    "--scale", f"{scale.get_value():.2f}", "--rotate", str(rot.get_selected()), "--position", pos.get_text().strip() or "auto"]
        prev = ["--resolution", cur_res, "--refresh", str(o["refresh"]), "--scale", str(o["scale"]), "--rotate", str(o["transform"]), "--position", f"{o['x']}x{o['y']}"]
        btn.connect("clicked", lambda *_: self.try_screen(o["name"], now(), prev))
        for r in (res, hz, scale, rot, pos): grp.add(r)
        grp.add(btn); return grp

    def try_screen(self, name, new, prev):
        self.say("Applying...")
        def work():
            rc, _, err = cli("screen", "set", name, *new, "--no-save")
            if rc != 0: self.say(err or "Could not apply"); return
            GLib.idle_add(self.confirm, name, new, prev)
        threading.Thread(target=work, daemon=True).start()

    def confirm(self, name, new, prev):
        dlg = Adw.MessageDialog(transient_for=self, heading="Keep these screen settings?", body="Reverting in 12 seconds if you do nothing.")
        dlg.add_response("revert", "Revert"); dlg.add_response("keep", "Keep")
        dlg.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED); dlg.set_default_response("revert")
        left = [12]
        def tick():
            left[0] -= 1
            if left[0] <= 0: dlg.close(); return False
            dlg.set_body(f"Reverting in {left[0]} seconds if you do nothing."); return True
        tid = GLib.timeout_add_seconds(1, tick)
        def done(d, resp):
            if left[0] > 0: GLib.source_remove(tid)
            def work():
                if resp == "keep": rc, _, err = cli("screen", "set", name, *new); self.say("Saved" if rc == 0 else err)
                else: cli("screen", "set", name, *prev, "--no-save"); self.say("Reverted")
                GLib.idle_add(self.load)
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", done); dlg.present()

    # ---- keys
    def build_keys(self, keys):
        if not keys:
            self.note("keys", "Shortcuts are added automatically on Hyprland. On other desktops, bind these commands in your own keyboard settings:\n"
                              "  glint-gui   (open Glint)\n  glint step brightness +10   /   glint step brightness -10\n"
                              "  glint profile apply night   /   day   /   gaming")
            return
        sw = Adw.SwitchRow(title="Shortcuts on", subtitle="Never overrides a shortcut you already use. Taken ones are skipped.")
        sw.set_active(keys["enabled"])
        sw.connect("notify::active", lambda r, _p: self.run_bg("keys", "on" if r.get_active() else "off"))
        g0 = Adw.PreferencesGroup(); g0.add(sw); self.pages["keys"].append(g0)
        g = Adw.PreferencesGroup(title="Change any of them", description="Click Record, then just press the keys you want. Glint writes it down for you. Esc cancels, Clear removes it.")
        for k in keys["keys"]:
            taken = k["status"].startswith("TAKEN")
            row = Adw.ActionRow(title=k["label"], subtitle=("Taken by another shortcut, skipped. Record a different one." if taken else k["status"] if k["status"] == "off" else ""))
            row.set_subtitle_lines(1)
            btn = Gtk.Button(label=k["combo"] or "(none)", valign=Gtk.Align.CENTER, tooltip_text="Click, then press your shortcut"); btn.add_css_class("pill")
            clr = Gtk.Button(icon_name="edit-clear-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Remove this shortcut"); clr.add_css_class("flat")
            btn.connect("clicked", lambda b, n=k["name"], c=k["combo"]: self.record_key(b, n, c))
            clr.connect("clicked", lambda _b, n=k["name"]: self.run_bg("keys", "set", n, "none"))
            row.add_suffix(btn); row.add_suffix(clr); row.set_activatable_widget(btn); g.add(row)
        self.pages["keys"].append(g)

    def record_key(self, btn, action, current):
        """Listen to the keyboard until a modifier+key is pressed; show what is held live."""
        self.stop_record()
        btn.set_label("Press your keys..."); btn.add_css_class("glint-rec")
        ctl = Gtk.EventControllerKey(); ctl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        def restore(text=None):
            self.stop_record(); btn.set_label(text if text is not None else (current or "(none)"))
        def pressed(c, keyval, keycode, state):
            name = Gdk.keyval_name(keyval) or ""
            mods = mods_of(state)
            if name in MOD_KEYS:
                btn.set_label(combo_text(mods) + " + ..." if mods else "Press your keys..."); return True
            if name == "Escape" and not mods: restore(); self.say("Cancelled"); return True
            if not mods:
                btn.set_label("Hold Super, Alt or Ctrl first"); return True
            combo = combo_text(mods, key_name(keyval, keycode))
            restore(combo); self.say(f"Saving {combo}...")
            self.run_bg("keys", "set", action, combo); return True
        ctl.connect("key-pressed", pressed)
        def released(c, keyval, keycode, state):
            if not self.rec: return
            btn.set_label(combo_text(mods_of(state)) + " + ..." if mods_of(state) else "Press your keys...")
        ctl.connect("key-released", released)
        self.add_controller(ctl); self.rec = (ctl, btn, current)
        GLib.timeout_add_seconds(15, lambda: (self.rec and self.rec[1] is btn and restore(), False)[1])

    def stop_record(self):
        if getattr(self, "rec", None):
            ctl, btn, _ = self.rec; self.remove_controller(ctl); btn.remove_css_class("glint-rec"); self.rec = None

    def run_bg(self, *args):
        def work():
            rc, out, err = cli(*args); self.say(out.strip() if rc == 0 else err)
            if rc == 0: GLib.idle_add(self.load)
        threading.Thread(target=work, daemon=True).start()

    # ---- look
    def build_look(self):
        cfg = theme_cfg(); t = self.theme.t or {}; p = t.get("palette")
        g = Adw.PreferencesGroup(title="Colours", description="Follows your setup live. Change the Caelestia scheme and this window changes with it.")
        sw = Adw.ActionRow(title="Right now", subtitle=("Wearing " + t.get("name", "")) if p else "Using your GTK / libadwaita theme")
        if p:
            box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            for k in ("bg", "card", "accent", "secondary", "tertiary", "fg"):
                d = Gtk.Box(); d.add_css_class("glint-dot"); d.add_css_class(f"dot-{k}"); box.append(d)
            sw.add_suffix(box)
        g.add(sw)
        src = Adw.ComboRow(title="Take colours from", subtitle="Auto tries Caelestia, then pywal, then your gtk.css",
                           model=Gtk.StringList.new(["Auto", "Caelestia", "Pywal", "My gtk.css", "System theme"]))
        src.set_selected(SOURCES.index(cfg.get("source", "auto")) if cfg.get("source", "auto") in SOURCES else 0)
        src.connect("notify::selected", lambda r, _p: self.run_quiet("theme", "set", "source", SOURCES[r.get_selected()])); g.add(src)
        rad = Adw.SpinRow.new_with_range(0, 32, 1); rad.set_title("Roundness"); rad.set_value(cfg.get("radius", 18))
        rad.connect("notify::value", lambda r, _p: self.schedule("rad", lambda: self.run_quiet("theme", "set", "radius", str(int(r.get_value()))))); g.add(rad)
        gl = Adw.SpinRow.new_with_range(0.3, 1.0, 0.05); gl.set_title("Glass"); gl.set_subtitle("Lower = see-through, if your compositor blurs windows"); gl.set_digits(2)
        gl.set_value(cfg.get("glass", 1.0))
        gl.connect("notify::value", lambda r, _p: self.schedule("glass", lambda: self.run_quiet("theme", "set", "glass", f"{r.get_value():.2f}"))); g.add(gl)
        acc = Adw.ActionRow(title="Accent colour", subtitle="Reset goes back to your theme's own")
        cb = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(), valign=Gtk.Align.CENTER)
        if cfg.get("accent"):
            c = Gdk.RGBA(); c.parse(cfg["accent"]); cb.set_rgba(c)
        cb.connect("notify::rgba", lambda b, _p: self.schedule("acc", lambda: self.run_quiet("theme", "set", "accent", hexc([b.get_rgba().red * 255, b.get_rgba().green * 255, b.get_rgba().blue * 255]))))
        rs = Gtk.Button(label="Reset", valign=Gtk.Align.CENTER); rs.connect("clicked", lambda *_: self.run_quiet("theme", "set", "accent", "reset"))
        acc.add_suffix(rs); acc.add_suffix(cb); g.add(acc)
        self.pages["look"].append(g)
        sg = Adw.PreferencesGroup(title="Whole desktop", description="Make GTK, Qt and wal-aware apps wear the same colours, and keep them in sync.")
        sync = Adw.SwitchRow(title="Sync other apps", subtitle="Needs Caelestia or pywal. Turn off to put your old GTK css back.")
        sync.set_active(self.sync_on)
        sync.connect("notify::active", lambda r, _p: self.run_bg("sync", "on" if r.get_active() else "off")); sg.add(sync)
        self.pages["look"].append(sg)
        pc = popup_cfg()
        pg = Adw.PreferencesGroup(title="Quick popup", description="Type `glint popup` (or press Super+Alt+P) for a small panel. Brightness is always first.")
        pos = Adw.ComboRow(title="Where it appears", model=Gtk.StringList.new([p.replace("-", " ").capitalize() for p in POSITIONS]))
        pos.set_selected(POSITIONS.index(pc["position"]) if pc["position"] in POSITIONS else 0)
        def set_pos(r, _p):
            c = popup_cfg(); c["position"] = POSITIONS[r.get_selected()]; save_popup(c)
            if c.get("pill"): self.run_quiet("pill", "restart")
        pos.connect("notify::selected", set_pos); pg.add(pos)
        for key, label in POPUP_PARTS:
            sw2 = Adw.SwitchRow(title="Show " + label.lower(), active=key in pc["show"])
            def tog(r, _p, key=key):
                c = popup_cfg(); sh = [x for x in c["show"] if x != key]
                if r.get_active(): sh.append(key)
                c["show"] = sh; save_popup(c)
            sw2.connect("notify::active", tog); pg.add(sw2)
        pill = Adw.SwitchRow(title="Hover icon beside Caelestia", subtitle="A tiny icon in the corner. Hover it for brightness, looks and all settings. Needs Caelestia / Quickshell.", active=bool(pc.get("pill")))
        pill.connect("notify::active", lambda r, _p: self.run_bg("pill", "on" if r.get_active() else "off")); pg.add(pill)
        self.pages["look"].append(pg)
        self.note("look", f"More: {CFG}/theme.json (colours, accent) or your own CSS in {CFG}/theme.css")

    def run_quiet(self, *args):
        threading.Thread(target=lambda: cli(*args), daemon=True).start()

    # ---- build
    def build(self, displays, profiles, auto, screens, keys, note):
        self.clear(); self.status.set_text(note)
        for o in screens: self.pages["screen"].append(self.build_screen(o))
        if not screens: self.note("screen", "Resolution and refresh rate need Hyprland, a wlroots compositor with wlr-randr, or an X11 session with xrandr. On GNOME or KDE Wayland, use your system Settings for these; brightness and colour still work in the Colour tab.")
        for d in displays:
            grp = Adw.PreferencesGroup(title=d["name"])
            for feat, label in LABELS.items():
                v = d["values"].get(feat)
                if not v: continue
                row = Adw.ActionRow(title=label, icon_name={"brightness": "display-brightness-symbolic", "contrast": "view-reveal-symbolic"}.get(feat))
                sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                if feat in ("red", "green", "blue"): sc.add_css_class(feat)
                sc.set_value(v["percent"]); sc.set_size_request(280, -1); sc.set_draw_value(True); sc.set_valign(Gtk.Align.CENTER)
                sc.connect("value-changed", self.on_slide, d["id"], feat); row.add_suffix(sc); grp.add(row)
            if "colour" in d["values"]:
                row = Adw.ComboRow(title="Colour temperature", model=Gtk.StringList.new(COLOURS))
                cur = d["values"]["colour"]["name"]
                row.set_selected(COLOURS.index(cur) if cur in COLOURS else Gtk.INVALID_LIST_POSITION)
                row.connect("notify::selected", self.on_colour, d["id"]); grp.add(row)
            self.pages["colour"].append(grp)
        if not displays: self.note("colour", "No monitor answered. External monitors need DDC/CI switched on in the monitor's menu; laptop panels work automatically. Run `glint doctor` for help.")
        if profiles:
            grp = Adw.PreferencesGroup(title="One-tap looks")
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, row_spacing=8, column_spacing=8)
            for p in profiles:
                b = Gtk.Button(label=p.capitalize()); b.add_css_class("pill"); b.add_css_class("suggested-action")
                b.connect("clicked", self.on_profile, p); flow.append(b)
            grp.add(flow); self.pages["colour"].append(grp)
        sync = Adw.PreferencesGroup(title="Sync with Caelestia")
        sw = Adw.SwitchRow(title="Match monitor to light/dark mode", subtitle="Day look when Caelestia is light, Night look when it is dark")
        sw.set_active(auto); sw.connect("notify::active", self.on_auto); sync.add(sw); self.pages["colour"].append(sync)
        self.build_keys(keys); self.build_look()

    def on_auto(self, row, _p):
        state = "on" if row.get_active() else "off"
        threading.Thread(target=lambda: cli("auto", state), daemon=True).start()
        self.say("Monitor will follow Caelestia light/dark" if state == "on" else "Automatic looks off")

    def schedule(self, key, fn):
        if key in self.timers: GLib.source_remove(self.timers[key])
        def fire(): self.timers.pop(key, None); fn(); return False
        self.timers[key] = GLib.timeout_add(350, fire)

    def run_set(self, disp, feat, val):
        def work(): rc, _, err = cli("set", feat, str(val), "--display", str(disp)); self.say("Done" if rc == 0 else err)
        threading.Thread(target=work, daemon=True).start()

    def on_slide(self, sc, disp, feat):
        v = int(sc.get_value()); self.say("Changing...")
        self.schedule((disp, feat), lambda: self.run_set(disp, feat, v))

    def on_colour(self, row, _p, disp):
        i = row.get_selected()
        if i != Gtk.INVALID_LIST_POSITION: self.schedule((disp, "colour"), lambda: self.run_set(disp, "colour", COLOURS[i]))

    def on_profile(self, _b, name):
        self.say(f"Applying {name}...")
        def work():
            rc, _, err = cli("profile", "apply", name); self.say("Done" if rc == 0 else err); GLib.idle_add(self.load)
        threading.Thread(target=work, daemon=True).start()


# ---------------------------------------------------------------- popup: small, simple, brightness first
class PopupWin(Gtk.Window):
    W = 340

    def __init__(self, app):
        super().__init__(application=app, title="Glint quick settings", decorated=False, resizable=False, default_width=self.W)
        self.app = app; self.timers = {}; self.seen_active = False; self.cfg = popup_cfg()
        self.add_css_class("glint-popwin")
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.body.add_css_class("glint-pop"); self.body.set_size_request(self.W, -1)
        self.set_child(self.body)
        head = Gtk.Box(spacing=8); t = Gtk.Label(label="✦ Glint", xalign=0, hexpand=True); t.add_css_class("pop-title"); head.append(t)
        full = Gtk.Button(icon_name="preferences-system-symbolic", tooltip_text="All settings"); full.add_css_class("flat"); full.connect("clicked", self.open_full)
        shut = Gtk.Button(icon_name="window-close-symbolic", tooltip_text="Close (Esc)"); shut.add_css_class("flat"); shut.connect("clicked", lambda *_: self.close())
        head.append(full); head.append(shut); self.body.append(head)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); self.body.append(self.content)
        self.status = Gtk.Label(label="Reading your monitor...", xalign=0); self.status.add_css_class("dim-label"); self.body.append(self.status)
        key = Gtk.EventControllerKey(); key.connect("key-pressed", lambda c, kv, kc, st: (self.close(), True)[1] if kv == Gdk.KEY_Escape else False); self.add_controller(key)
        self.connect("notify::is-active", self.on_active)
        self.place(); self.load()

    # -- where it sits: real layer-shell when available, otherwise ask Hyprland to float + move it
    def place(self):
        pos = self.cfg["position"]
        if LS and LS.is_supported():
            LS.init_for_window(self); LS.set_namespace(self, "glint-popup"); LS.set_layer(self, LS.Layer.OVERLAY)
            LS.set_keyboard_mode(self, LS.KeyboardMode.ON_DEMAND)
            for edge, name in ((LS.Edge.TOP, "top"), (LS.Edge.BOTTOM, "bottom"), (LS.Edge.LEFT, "left"), (LS.Edge.RIGHT, "right")):
                LS.set_anchor(self, edge, name in pos); LS.set_margin(self, edge, 14)
            self.layer = True
        else:
            self.layer = False
            GLib.timeout_add(250, self.hypr_place)

    def hypr_place(self):
        hc = shutil.which("hyprctl")
        if not hc: return False
        try:
            win = next(w for w in json.loads(subprocess.run([hc, "clients", "-j"], capture_output=True, text=True, timeout=3).stdout)
                       if w.get("title") == "Glint quick settings")
            mon = next(m for m in json.loads(subprocess.run([hc, "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout) if m.get("focused"))
            sc = mon.get("scale") or 1; mw, mh = int(mon["width"] / sc), int(mon["height"] / sc)
            w, h = win["size"]; pos = self.cfg["position"]
            x = mon["x"] + (14 if "left" in pos else mw - w - 14 if "right" in pos else (mw - w) // 2)
            y = mon["y"] + (mh - h - 14 if "bottom" in pos else 14)
            a = f"address:{win['address']}"
            subprocess.run([hc, "--batch", f"dispatch setfloating {a} ; dispatch movewindowpixel exact {x} {y},{a}"], capture_output=True, timeout=3)
        except Exception: pass
        return False

    def on_active(self, *_):
        if self.is_active(): self.seen_active = True; return
        if self.seen_active: GLib.timeout_add(300, self.maybe_close)    # clicked somewhere else: tidy up

    def maybe_close(self):
        if not self.is_active(): self.close()
        return False

    def open_full(self, *_):
        self.app.show_main(); self.close()

    def say(self, text): GLib.idle_add(self.status.set_text, text)

    def load(self):
        def work():
            rc, out, err = cli("get", "--json"); _, prof, _ = cli("profile", "list", "--json")
            disp = json.loads(out)["displays"] if rc == 0 and out.strip() else []
            try: profiles = json.loads(prof or "[]")
            except Exception: profiles = []
            GLib.idle_add(self.build, disp, profiles, "" if rc == 0 else (err or "No monitor answered. Open all settings and run Glint's doctor."))
        threading.Thread(target=work, daemon=True).start()

    def slider(self, d, feat, label):
        v = d["values"].get(feat)
        if not v: return None
        row = Gtk.Box(spacing=10); l = Gtk.Label(label=label, xalign=0, width_chars=10); row.append(l)
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); sc.set_hexpand(True); sc.set_draw_value(True); sc.set_value(v["percent"])
        if feat in ("red", "green", "blue"): sc.add_css_class(feat)
        sc.connect("value-changed", lambda s, did=d["id"], f=feat: self.later((did, f), lambda: self.run_set(did, f, int(s.get_value())))); row.append(sc)
        return row

    def build(self, displays, profiles, note):
        while (c := self.content.get_first_child()): self.content.remove(c)
        self.status.set_text(note)
        show = self.cfg["show"]; many = len(displays) > 1
        more = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for d in displays:
            if many:
                n = Gtk.Label(label=d["name"], xalign=0); n.add_css_class("heading"); self.content.append(n)
            r = self.slider(d, "brightness", "Brightness")
            if r: self.content.append(r)
            if "contrast" in show:
                r = self.slider(d, "contrast", "Contrast"); r and more.append(r)
            if "rgb" in show:
                for f in ("red", "green", "blue"):
                    r = self.slider(d, f, f.capitalize()); r and more.append(r)
            if "colour" in show and "colour" in d["values"]:
                cb = Gtk.DropDown.new_from_strings(COLOURS); cur = d["values"]["colour"]["name"]
                if cur in COLOURS: cb.set_selected(COLOURS.index(cur))
                cb.connect("notify::selected", lambda w, _p, did=d["id"]: self.later((did, "colour"), lambda: self.run_set(did, "colour", COLOURS[w.get_selected()])))
                row = Gtk.Box(spacing=10); row.append(Gtk.Label(label="Colour", xalign=0, width_chars=10)); cb.set_hexpand(True); row.append(cb); more.append(row)
        if profiles and "looks" in show:
            flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3, row_spacing=6, column_spacing=6)
            for p in profiles:
                b = Gtk.Button(label=p.capitalize()); b.add_css_class("pill"); b.connect("clicked", self.on_profile, p); flow.append(b)
            self.content.append(flow)
        if more.get_first_child():
            ex = Gtk.Expander(label="More"); ex.set_child(more); self.content.append(ex)
        if not displays: self.content.append(Gtk.Label(label="No monitor answered yet.", wrap=True))
        btn = Gtk.Button(label="All settings"); btn.add_css_class("pill"); btn.add_css_class("suggested-action"); btn.connect("clicked", self.open_full)
        self.content.append(btn)

    def later(self, key, fn):
        if key in self.timers: GLib.source_remove(self.timers[key])
        def fire(): self.timers.pop(key, None); fn(); return False
        self.timers[key] = GLib.timeout_add(300, fire)

    def run_set(self, disp, feat, val):
        def work(): rc, _, err = cli("set", feat, str(val), "--display", str(disp)); self.say("" if rc == 0 else err)
        threading.Thread(target=work, daemon=True).start()

    def on_profile(self, _b, name):
        self.say(f"Applying {name}...")
        def work(): rc, _, err = cli("profile", "apply", name); self.say("" if rc == 0 else err); GLib.idle_add(self.load)
        threading.Thread(target=work, daemon=True).start()


class App(Adw.Application):
    """One running Glint: `glint-gui` opens the main window, `glint-gui --popup` toggles the small popup."""
    def __init__(self):
        super().__init__(application_id="io.github.krvats.glint", flags=Gio.ApplicationFlags.HANDLE_COMMAND_LINE)
        self.theme = None; self.main = None; self.pop = None
        self.connect("command-line", self.on_cmd)

    def on_cmd(self, _a, cl):
        args = cl.get_arguments()[1:]
        if self.theme is None: self.theme = Theme()
        if "--popup" in args or "--toggle" in args: self.toggle_popup()
        else: self.show_main()
        return 0

    def show_main(self):
        if self.main is None: self.main = Win(self)
        self.main.present()

    def toggle_popup(self):
        if self.pop is not None: self.pop.close(); return
        self.pop = PopupWin(self)
        self.pop.connect("close-request", lambda *_: (setattr(self, "pop", None), False)[1])
        self.pop.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
